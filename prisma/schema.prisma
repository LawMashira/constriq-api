  finalCost              Decimal?       @db.Decimal(18, 2)
  finalClaims            Decimal?       @db.Decimal(18, 2)
  finalCertifiedAmount   Decimal?       @db.Decimal(18, 2)
  finalPayments          Decimal?       @db.Decimal(18, 2)
  finalRetention         Decimal?       @db.Decimal(18, 2)
  finalProfit            Decimal?       @db.Decimal(18, 2)
  finalMargin            Decimal?       @db.Decimal(8, 4)
  originalExpectedProfit Decimal?       @db.Decimal(18, 2)
  profitAtRisk           Decimal?       @db.Decimal(18, 2)
  outstandingCommitments Decimal?       @db.Decimal(18, 2)
  outstandingClaims      Decimal?       @db.Decimal(18, 2)
  outstandingPayments    Decimal?       @db.Decimal(18, 2)
  majorLeakageSummary    Json?
  lessonsLearned         String?
  closedAt               DateTime?
