model CompanyFinancialSnapshot {
  id                     String   @id @default(cuid())
  companyId              String
  activeProjectCount     Int      @default(0)
  totalContractValue     Decimal  @db.Decimal(18, 2)
  revisedContractValue   Decimal  @db.Decimal(18, 2)
  totalOriginalBudget    Decimal  @db.Decimal(18, 2)
  actualCost             Decimal  @db.Decimal(18, 2)
  committedCost          Decimal  @db.Decimal(18, 2)
  forecastFinalCost      Decimal  @db.Decimal(18, 2)
  expectedProfit         Decimal  @db.Decimal(18, 2)
  forecastProfit         Decimal  @db.Decimal(18, 2)
  profitAtRisk           Decimal  @db.Decimal(18, 2)
  expectedMargin         Decimal  @db.Decimal(8, 4)
  forecastMargin         Decimal  @db.Decimal(8, 4)
  atRiskProjectCount     Int      @default(0)
  criticalProjectCount   Int      @default(0)
  revenueOutstanding     Decimal  @db.Decimal(18, 2)
  cashFlowExposure       Decimal  @db.Decimal(18, 2)
  snapshotDate           DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, snapshotDate])
}

model AiInsight {
