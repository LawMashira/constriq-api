/*
|--------------------------------------------------------------------------
| COMPANY / TENANCY
|--------------------------------------------------------------------------
*/

model Company {
  id             String        @id @default(cuid())
  legalName      String
  tradingName    String?
  registrationNo String?
  taxNumber      String?
  vatNumber      String?
  address        String?
  email          String?
  phone          String?
  logoUrl        String?
  country        String        @default("ZA")
  currency       String        @default("ZAR")
  status         CompanyStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  settings              CompanySetting?
  documentSequences     DocumentSequence[]
  users                 User[]
  memberships           CompanyMembership[]
  sessions              UserSession[]
  roleDefinitions       RoleDefinition[]
  projects              Project[]
  clients               Client[]
  consultants           Consultant[]
  suppliers             Supplier[]
  subcontractors        Subcontractor[]
  workers               Worker[]
  equipment             Equipment[]
  costCodeTemplates     CostCodeTemplate[]
  documents             Document[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  approvalRules         ApprovalRule[]
  approvals             Approval[]
  scenarios             Scenario[]
  financialPostings     FinancialPosting[]
  actualCosts           ActualCost[]
  reconciliations       ReconciliationRecord[]
  imports               DataImport[]
  accountingConnections AccountingConnection[]
  historicalRates       HistoricalCostRate[]
  historicalOutcomes    HistoricalProjectOutcome[]
  financialSnapshots    CompanyFinancialSnapshot[]
  aiInsights            AiInsight[]
  generatedReports      GeneratedReport[]

  @@index([legalName])
}

model CompanySetting {
  id                         String                @id @default(cuid())
  companyId                  String                @unique
  defaultCurrency            String                @default("ZAR")
  financialYearStartMonth    Int                   @default(3)
  defaultPaymentTermsDays    Int                   @default(30)
  defaultRetentionPercent    Decimal               @default(10) @db.Decimal(8, 4)
  variationRevenueRule       VariationRevenueRule  @default(APPROVED)
  forecastStaleDays          Int                   @default(14)
  defaultVatRate             Decimal               @default(15) @db.Decimal(8, 4)
  taxInclusiveDefault        Boolean               @default(false)
  defaultApprovalThreshold   Decimal?              @db.Decimal(18, 2)
  notificationChannels       Json?
  dataRetentionDays          Int?
  auditRetentionDays         Int?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model DocumentSequence {
  id          String     @id @default(cuid())
  companyId   String
  entityType  EntityType
  prefix      String
  nextNumber  Int        @default(1)
  padding     Int        @default(5)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, entityType])
}

model EmailOtp {
  id         String     @id @default(cuid())
  email      String
  userId     String?
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, createdAt])
  @@index([userId])
}

model User {
  id              String     @id @default(cuid())
  companyId       String
  name            String
  email           String     @unique
  passwordHash    String?
  status          UserStatus @default(INVITED)
  emailVerifiedAt DateTime?
  mfaEnabled      Boolean    @default(false)
  mfaSecret       String?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  memberships         CompanyMembership[]
  roles               UserRole[]
  projects            ProjectUser[]
  sessions            UserSession[]
  approvalsRequested  Approval[]           @relation("ApprovalRequestedBy")
  approvalsDecided    Approval[]           @relation("ApprovalDecidedBy")
  auditLogs           AuditLog[]
  notifications       Notification[]
  uploadedDocuments   Document[]           @relation("DocumentUploadedBy")
  forecastsCreated    CostForecast[]
  actualCostsCreated  ActualCost[]
  budgetRevisions     BudgetRevision[]
  managedProjects     Project[]            @relation("ProjectManager")
  emailOtps           EmailOtp[]
  procurementRequested ProcurementRequest[] @relation("ProcurementRequestedBy")
  procurementApproved  ProcurementRequest[] @relation("ProcurementApprovedBy")

  @@index([companyId])
}

/*
 * Official tenant join. User.companyId is the active/home company for this
 * session of work. A user may later hold memberships in more than one company;
 * JWT companyId must always match an ACTIVE membership.
 */
model CompanyMembership {
  id        String           @id @default(cuid())
  companyId String
  userId    String
  status    MembershipStatus @default(INVITED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId, status])
}

model UserSession {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  tokenHash String    @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RoleDefinition {
  id          String      @id @default(cuid())
  companyId   String
  name        String
  description String?
  systemRole  SystemRole?
  isReadOnly  Boolean     @default(false)
  isSystem    Boolean     @default(false)
  createdAt   DateTime    @default(now())

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions   RolePermission[]
  users         UserRole[]
  approvalRules ApprovalRule[]
  projectUsers  ProjectUser[]

  @@unique([companyId, name])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String?
  module      PermissionModule

  roles RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

/*
|--------------------------------------------------------------------------
| PROJECTS / CONTRACTS / PARTIES
|--------------------------------------------------------------------------
*/

model Client {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  registrationNo String?
  taxNumber      String?
  email          String?
  phone          String?
  address        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projects Project[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Consultant {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  registrationNo String?
  taxNumber      String?
  email          String?
  phone          String?
  address        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, name])
}

model Project {
  id                   String        @id @default(cuid())
  companyId            String
  clientId             String?
  projectManagerId     String?
  code                 String
  name                 String
  description          String?
  siteAddress          String?
  projectType          ProjectType   @default(OTHER)
  status               ProjectStatus @default(TENDER)
  currency             String        @default("ZAR")
  contractNo           String?
  contractStartDate    DateTime?
  plannedCompletionDate DateTime?
  actualCompletionDate DateTime?
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  company        Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client         Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectManager User?   @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)

  users               ProjectUser[]
  contacts            ProjectContact[]
  contracts           Contract[]
  contractRevisions   ContractRevision[]
  costCodes           CostCode[]
  boqs                Boq[]
  budget              ProjectBudget?
  budgetRevisions     BudgetRevision[]
  variations          Variation[]
  actualCosts         ActualCost[]
  suppliers           SupplierProject[]
  procurementRequests ProcurementRequest[]
  purchaseOrders      PurchaseOrder[]
  commitments         Commitment[]
  invoices            SupplierInvoice[]
  subcontracts        Subcontract[]
  subcontractClaims   SubcontractClaim[]
  labourRecords       LabourRecord[]
  equipmentAllocations EquipmentAllocation[]
  plantRecords        PlantRecord[]
  workPackages        WorkPackage[]
  activities          Activity[]
  milestones          Milestone[]
  generatedReports    GeneratedReport[]
  progressRecords     ProgressRecord[]
  progressClaims      ProgressClaim[]
  certifications      Certification[]
  payments            Payment[]
  cashFlows           CashFlowEntry[]
  forecasts           CostForecast[]
  health              ProjectHealth?
  healthSnapshots     ProjectHealthSnapshot[]
  leakages            LeakageFinding[]
  costCodePositions   CostCodePosition[]
  documents           Document[]
  approvals           Approval[]
  scenarios           Scenario[]
  closeout            ProjectCloseout?
  historicalOutcome   HistoricalProjectOutcome?
  financialPostings   FinancialPosting[]
  revenuePostings     RevenuePosting[]
  imports             DataImport[]
  reconciliations     ReconciliationRecord[]
  historicalRates     HistoricalCostRate[]
  aiInsights          AiInsight[]
  notifications       Notification[]
  workers             WorkerProject[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

model ProjectUser {
  id        String  @id @default(cuid())
  projectId String
  userId    String
  roleId    String?

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    RoleDefinition? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
}

model ProjectContact {
  id        String    @id @default(cuid())
  projectId String
  partyType PartyType
  name      String
  email     String?
  phone     String?
  role      String?
  notes     String?
  createdAt DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Contract {
  id            String  @id @default(cuid())
  companyId     String
  projectId     String
  contractNo    String
  title         String
  originalValue Decimal @db.Decimal(18, 2)

  /*
   * Cached from RevenuePosting (CONTRACT_BASE + qualifying variations).
   * Must be updated transactionally from RevenuePosting.
   * Never manually edited by application code.
   */
  revisedValue Decimal @db.Decimal(18, 2)

  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  revisions       ContractRevision[]
  revenuePostings RevenuePosting[]

  @@unique([projectId, contractNo])
  @@index([companyId])
}

model ContractRevision {
  id            String   @id @default(cuid())
  projectId     String
  contractId    String
  previousValue Decimal  @db.Decimal(18, 2)
  newValue      Decimal  @db.Decimal(18, 2)
  reason        String
  createdById   String
  createdAt     DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@index([projectId])
}

