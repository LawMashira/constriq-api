model CostCodeTemplate {
  id          String       @id @default(cuid())
  companyId   String
  code        String
  name        String
  category    CostCategory @default(OTHER)
  description String?
  createdAt   DateTime     @default(now())

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  costCodes CostCode[]

  @@unique([companyId, code])
}

model CostCode {
  id          String       @id @default(cuid())
  companyId   String
  projectId   String
  templateId  String?
  code        String
